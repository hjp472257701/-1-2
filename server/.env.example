# 复制本文件为 server/.env 后填写（勿提交 .env）
# cp server/.env.example server/.env

PORT=3001

# SQLite 路径；生产环境建议绝对路径，例如 /var/lib/thesis-data/data.sqlite3
DB_PATH=./data.sqlite3

# 导出 CSV、/admin 管理页使用；请改为长随机串（openssl rand -hex 32）
EXPORT_TOKEN=

# 研究二程序版本；每次实质性改版必须更换，正式部署前记录该值
STUDY_VERSION=q2_v2_20260713

# 未使用管理员邀请链接直接进入时的数据角色；V2 测试阶段保持 test
# 正式数据建议一律通过 /admin 生成 data_role=formal 的邀请链接
DEFAULT_DATA_ROLE=test

# 研究二 V3.9 透明任务伙伴测试版；当前保持 test，正式开关必须为 false
ONLINE_POINTS_STUDY_VERSION=q2_v4_0_reappraisal_15trial_test1_20260716
ONLINE_POINTS_DEFAULT_DATA_ROLE=test
ONLINE_POINTS_FORMAL_ENABLED=false

# 可选：前端与 API 不同域时，填前端来源，多个用英文逗号分隔
# CORS_ORIGIN=https://你的前端域名

# 可选：与前端公网地址一致（不要末尾 /），用于管理端生成完整邀请链接
# PUBLIC_WEB_URL=https://你的公网IP或域名
