[Unit]
Description=Study 3 isolated technical preview (formal collection disabled)
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/var/www/study3-preview/current
Environment=S3_PUBLIC_ORIGIN=http://101.34.238.243
Environment=S3_DATA_DIR=/var/lib/study3-preview
Environment=S3_CLOUD_PORT=8785
ExecStart=/opt/study3-runtime/node-v24.22.0-linux-x64/bin/node /var/www/study3-preview/current/cloud-preview.mjs
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/study3-preview
InaccessiblePaths=/var/www/thesis-app
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=256M
CPUQuota=50%
LimitNOFILE=2048

[Install]
WantedBy=multi-user.target
